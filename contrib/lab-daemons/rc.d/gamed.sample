#!/bin/sh

# PROVIDE: gamed
# REQUIRE: NETWORKING FILESYSTEMS
# KEYWORD: shutdown

# FreeBSD rc.d sample for metin2 gamed. Disabled by default.
# Install as /usr/local/etc/rc.d/gamed.sample, review, then rename without
# .sample and flip gamed_enable deliberately. Never embed DSN / SQL / password
# markers. Ops stay loopback-only. Stop uses SIGTERM via rc.subr (no store wipe).
# JSON stdout/stderr append to /var/log/metin2/gamed.log via daemon -o/-H so
# newsyslog can SIGHUP-reopen without discarding the observability contract.

. /etc/rc.subr

name="gamed"
rcvar="gamed_enable"
desc="metin2 gamed (world / PvE / persistence ops)"

load_rc_config "$name"

: "${gamed_enable:=NO}"
: "${gamed_user:=metin2}"
: "${gamed_bin:=/usr/local/bin/gamed}"
: "${gamed_env_file:=/etc/metin2/metin2-gamed.env}"
: "${gamed_logfile:=/var/log/metin2/gamed.log}"

pidfile="/var/run/${name}.pid"
command="/usr/sbin/daemon"
procname="${gamed_bin}"
# -f closes inherited fds; -o/-H capture JSON stdout after that and reopen on SIGHUP.
command_args="-f -H -o ${gamed_logfile} -p ${pidfile} -u ${gamed_user} ${procname}"
start_precmd="${name}_prestart"

gamed_prestart()
{
	if [ -r "${gamed_env_file}" ]; then
		set -a
		# shellcheck disable=SC1090
		. "${gamed_env_file}"
		set +a
	fi
	return 0
}

run_rc_command "$1"
