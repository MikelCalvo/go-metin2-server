# Lab role env for the auth host of a two-host split.
# Review before copying to /etc/metin2/metin2-authd.env on that host only.
# Disabled by default: do not start authd from this file.
# Share these two directories with the game host via an operator mount.
# This repository does not provision or export that mount.
# Never put DSNs, passwords, login keys, or executable SQL here.
# Ops stay loopback-only; do not bind a wildcard or public hostname for pprof.

METIN2_LOGIN_TICKET_STORE_DIR=/var/metin2/shared/login-tickets
METIN2_ACCOUNT_STORE_DIR=/var/metin2/shared/accounts
METIN2_AUTHD_PPROF_ADDR=127.0.0.1:6061
METIN2_AUTHD_LEGACY_ADDR=:11002

# Optional LAN/VPN advertise so clients on the game host can reach login.
# Ops remain on loopback. Uncomment only after review.
# METIN2_AUTHD_PUBLIC_ADDR=10.22.1.10
