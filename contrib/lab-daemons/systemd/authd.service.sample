[Unit]
Description=metin2 authd (login / ticket issue)
Documentation=file:///opt/metin2/go-metin2-server/docs/workflow/lab-daemon-unit-samples.md
After=local-fs.target network-online.target
RequiresMountsFor=/var/metin2

[Service]
Type=simple
User=metin2
Group=metin2
ExecStartPre=/usr/bin/test -x /usr/local/bin/authd
ExecStart=/usr/local/bin/authd
KillSignal=SIGTERM
TimeoutStopSec=30
# Capture redacted JSON process logs beside lab evidence (journal still receives them).
StandardOutput=append:/var/log/metin2/authd.log
StandardError=append:/var/log/metin2/authd.log
# Explicit non-goals: no Environment=DSN, no metin2-migrate apply, no store wipe.
Nice=0

[Install]
WantedBy=multi-user.target
