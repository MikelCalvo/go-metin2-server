# FreeBSD periodic.conf fragment for metin2 retention/GC print-only dumps.
# Copy reviewed knobs into /etc/periodic.conf or /usr/local/etc/periodic.conf.
# Keep the enable flag NO until an operator deliberately flips it.

# Default stays disabled. Only "YES" (case-insensitive) runs the print helper.
weekly_metin2_artifact_retention_gc_print_enable="NO"

# Optional overrides (uncomment after review). Never put DSNs, passwords,
# login keys, or executable SQL here.
# METIN2_MIGRATE_BIN=/usr/local/bin/metin2-migrate
# METIN2_OPS_PRINTS_ROOT=/var/metin2/ops-prints
# METIN2_RETENTION_KEEP_DAYS=14
# METIN2_PRINT_RETENTION_GC_HELPER=/usr/local/libexec/metin2-print-retention-gc.sh
# METIN2_RUNTIME_CONFIG=/var/metin2/ops-prints/retained-runtime-config.json
# METIN2_GAMED_LOG_PATH=/var/log/metin2/gamed.log
# METIN2_AUTHD_LOG_PATH=/var/log/metin2/authd.log
# METIN2_IMPORT_EXPORT_TREE=/var/metin2/exports/20260827T120000Z-abcdef012345
# METIN2_IMPORT_DRIVER=sqlite3
# METIN2_IMPORT_DSN_ENV=METIN2_IMPORT_DSN
