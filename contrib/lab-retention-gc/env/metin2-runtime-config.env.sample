# Print-only companion env for metin2-print-retention-gc.sh.
# Point at a retained runtime-config JSON snapshot (non-symlink regular file).
# Do NOT put DSNs, passwords, or live ops fetches here.
# Review before copying to /etc/metin2/metin2-runtime-config.env (or similar).
METIN2_RUNTIME_CONFIG=/var/metin2/ops-prints/retained-runtime-config.json
