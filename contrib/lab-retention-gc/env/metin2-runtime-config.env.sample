# Print-only companion env for metin2-print-retention-gc.sh.
# Point at a retained runtime-config JSON snapshot (non-symlink regular file).
# Do NOT put DSNs, passwords, or live ops fetches here.
# Review before copying to /etc/metin2/metin2-runtime-config.env (or similar).
METIN2_RUNTIME_CONFIG=/var/metin2/ops-prints/retained-runtime-config.json

# Optional absolute daemon JSON log paths forwarded to migration-run-retention,
# export-quarantine-drill, and backup-restore-drill printers (defaults match lab
# topology). Relative / blank values fail closed in the printers; missing files
# stay non-fatal in the printed retain scripts.
METIN2_GAMED_LOG_PATH=/var/log/metin2/gamed.log
METIN2_AUTHD_LOG_PATH=/var/log/metin2/authd.log

# Optional confirmation-gated import-export-drill companion. Both the absolute
# retained export/quarantine tree and an opaque database/sql driver name are
# required before the helper prints import-export-drill.sh. METIN2_IMPORT_DSN_ENV
# is only the environment variable *name* the printed script will read later —
# never put a DSN value, password, or connection string here.
# METIN2_IMPORT_EXPORT_TREE=/var/metin2/exports/20260827T120000Z-abcdef012345
# METIN2_IMPORT_DRIVER=sqlite3
# METIN2_IMPORT_DSN_ENV=METIN2_IMPORT_DSN
