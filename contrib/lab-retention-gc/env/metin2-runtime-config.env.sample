# Print-only companion env for metin2-print-retention-gc.sh.
# Point at a retained runtime-config JSON snapshot (non-symlink regular file).
# Do NOT put DSNs, passwords, or live ops fetches here.
# Review before copying to /etc/metin2/metin2-runtime-config.env (or similar).
METIN2_RUNTIME_CONFIG=/var/metin2/ops-prints/retained-runtime-config.json

# Optional absolute daemon JSON log paths forwarded to migration-run-retention
# and backup-restore-drill printers (defaults match lab topology). Relative /
# blank values fail closed in the printers; missing files stay non-fatal in the
# printed retain scripts.
METIN2_GAMED_LOG_PATH=/var/log/metin2/gamed.log
METIN2_AUTHD_LOG_PATH=/var/log/metin2/authd.log
